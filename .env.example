# Compose profiles to start: bundled = Postgres + Redis in Docker; add https for the Caddy reverse proxy.
# Leave empty to use your own Postgres and Redis (then set DATABASE_URL and REDIS_URL below).
COMPOSE_PROFILES=bundled
# Image tag to run (ghcr.io/return-nol/adus:<tag>); pin a release instead of latest for repeatable updates.
ADUS_VERSION=latest
# Host port for the dashboard and webhooks.
ADUS_PORT=8000
# The address GitHub/Azure DevOps and your browser use to reach Adus, e.g. https://adus.example.com (webhooks need it to be public).
ADUS_PUBLIC_URL=
# Encrypts stored PATs and LLM keys; generate with `adus gen-secret`. Back it up: if it changes, stored PATs/LLM keys cannot be decrypted until the original key is restored.
ADUS_SECRET_KEY=
# Password of the bundled Postgres (the installer generates one); only used when COMPOSE_PROFILES contains bundled.
POSTGRES_PASSWORD=
# External Postgres only: connection URL, e.g. postgres://user:pass@host:5432/adus.
# DATABASE_URL=
# External Redis only: connection URL, e.g. redis://host:6379.
# REDIS_URL=
# Public domain served by the Caddy profile `https` (DNS must point at this host; ports 80 and 443 must be open).
# ADUS_DOMAIN=
# Number of review workers running inside the adus process.
ADUS_WORKERS=2
# Log level: error, warn, info, debug or trace.
RUST_LOG=info
